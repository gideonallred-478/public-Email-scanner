# Copy to `.env.local` in the project root, then restart `npm run dev`.
# The mail bridge reads these server-side (never put passwords in VITE_ vars).

# imap | microsoft-graph | local-smtp-inbox
MAILBOX_PROVIDER=local-smtp-inbox

# Address shown on linked dashboard records
MAILBOX_ADDRESS=tester@localhost

# --- Optional multi-mailbox pilot registry ---
# When MAILBOXES_JSON is set, it overrides the single-mailbox settings above.
# It is deliberately limited to 1-10 entries. Every entry needs a unique lowercase
# opaque id and unique mailbox address. Keep this value only in the untracked server
# environment because real IMAP/Graph entries can contain passwords or tokens.
# Synthetic local example (one line in .env.local):
# MAILBOXES_JSON=[{"id":"pilot-01","label":"Pilot Student 01","provider":"local-smtp-inbox","mailbox":"pilot01@example.invalid","localSmtpInbox":{"path":"C:/scanner/pilot01-inbox","statePath":"C:/scanner/pilot01-state.json","host":"127.0.0.1","port":1025}},{"id":"pilot-02","label":"Pilot Student 02","provider":"local-smtp-inbox","mailbox":"pilot02@example.invalid","localSmtpInbox":{"path":"C:/scanner/pilot02-inbox","statePath":"C:/scanner/pilot02-state.json","host":"127.0.0.1","port":1025}}]
# Note: remove the leading "# " only; the value itself is JSON and belongs on one line.
# For multi-line JSON, set MAILBOXES_JSON_FILE to an absolute path whose contents
# are the raw JSON (recommended once real credentials are involved).
# Do not commit real mailbox credentials and never put MAILBOXES_JSON in a VITE_* var.

# --- Local SMTP harness ---
# `npm run dev` starts the local SMTP harness, mail bridge, and Vite UI together.
# Use `npm run smtp:harness` only when you intentionally want SMTP by itself.
SMTP_INBOX_PATH=./smtp-inbox
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_LOCAL_HARNESS=true

# --- IMAP (Gmail, Outlook.com, many school hosts) ---
# Gmail: enable 2FA and create an App Password at https://myaccount.google.com/apppasswords
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=you@gmail.com
# IMAP_PASSWORD="xxxx xxxx xxxx xxxx"
# IMAP_TLS=true

# --- Gmail OAuth (recommended if App Password keeps failing) ---
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=

# --- Microsoft Graph (Microsoft 365 / Outlook school accounts) ---
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_MAILBOX=you@yourdomain.com

# Optional: mail bridge port (local development default 8790; avoids Hermes WebUI on 8787)
# MAIL_BRIDGE_PORT=8790

# Shared site lists + suggestions across devices (required by the mail bridge)
# The mail bridge binds to loopback by default, but still requires server-provisioned
# accounts. `npm run dev` generates and prints an ephemeral local password when this
# value is absent. For persistent or private-network use, set an untracked JSON array
# of username/password/role/displayName objects; passwords must be at least 12 chars.
# For multi-line JSON, set SHARED_AUTH_USERS_JSON_FILE to an absolute path instead.
# SHARED_DATA_ENABLED=true
# MAIL_BRIDGE_HOST=127.0.0.1
# SHARED_AUTH_USERS_JSON=
# Exact comma-separated browser UI origins allowed to call the API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional durable mailbox-provenance secret (minimum 32 characters). When omitted,
# a random key is created in ignored .data/mail-provenance.key and reused on restart.
# MAIL_PROVENANCE_SECRET=

# Optional: email IT when a student submits a site list suggestion
# SUGGESTION_NOTIFY_ENABLED=true
# SUGGESTION_NOTIFY_TO=it@school.edu

# Frontend-only: override API base when UI is not proxied through Vite (e.g. http://192.168.1.10:8790)
# VITE_API_BASE=http://192.168.1.10:8790

# How far back to scan on first poll (hours). Default 48. Inbox + spam only.
# MAILBOX_LOOKBACK_HOURS=48

# Frontend-only hints (optional; server .env.local is the source of truth)
VITE_MAILBOX_PROVIDER=local-smtp-inbox
VITE_MAILBOX_ADDRESS=tester@localhost
#
# --- Durable IT notification routing ---
# Fixed server policy (not client-configurable):
#   0-4  -> no outbound notification
#   5-7  -> review email to ALERT_NOTIFY_TO
#   8-10 -> urgent Web Push to subscribed Admin/IT browsers
# The worker persists jobs in ALERTS_DATA_PATH and retries transient failures.
# Use only synthetic records and the local SMTP harness until production review.
# ALERT_NOTIFY_ENABLED=true
# ALERT_NOTIFY_TO=tester@localhost
# ALERT_NOTIFY_MAX_ATTEMPTS=5
# ALERT_NOTIFY_POLL_INTERVAL_MS=5000
#
# Web Push requires a VAPID key pair. Generate it deliberately with:
#   npx web-push generate-vapid-keys
# Store the private key only in .env.local or a secret manager; never VITE_*.
# WEB_PUSH_VAPID_SUBJECT=mailto:security@example.org
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# Optional comma-separated exact hosts for an approved additional push provider.
# Built-in browser push hosts are already allowed; arbitrary URLs are rejected.
# WEB_PUSH_ALLOWED_HOSTS=
#
# SMS and generic third-party/webhook adapters are scaffolded but disabled until
# an approved provider, recipient model, and secret-management path are selected.
#
# For real Gmail SMTP instead:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
#
# Vercel/public hosting: leave unset — production builds default to Demo tab only.
# VITE_MAILBOX_LIVE=true
