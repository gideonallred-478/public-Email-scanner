{
  "name": "senior-email-scanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:mail": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "test:mail": "node scripts/test-mail-connection.mjs",
    "gmail:auth": "node scripts/gmail-oauth-setup.mjs",
    "smtp:harness": "node scripts/smtp-harness.mjs --host 127.0.0.1 --port 1025 --inbox smtp-inbox",
    "test:verbose": "node --test --test-reporter spec scripts/test/demo-scenarios.test.mjs scripts/test/lookalikes.test.mjs scripts/test/alerts.test.mjs scripts/test/risk-vocabulary.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "google-auth-library": "^10.9.1",
    "imapflow": "^1.0.184",
    "mailparser": "^3.7.2",
    "nodemailer": "^10.0.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldts": "^7.4.10",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.7"
  }
}
